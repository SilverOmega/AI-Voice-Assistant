# Copy to .env and adjust. Used by Docker Compose and by the native dev scripts.

# ---- Language model --------------------------------------------------------
# ollama (local, default) | anthropic (Claude API) | echo (offline test mode)
LLM_PROVIDER=ollama
# Leave empty to use the provider's default model (OLLAMA_MODEL / ANTHROPIC_MODEL).
LLM_MODEL=

# Ollama model pulled automatically by `docker compose up` (try llama3.2, qwen2.5:7b, gemma3...)
OLLAMA_MODEL=llama3.2
# How long the model stays loaded after a reply (30m, 24h, or -1m for never). Reloading takes 20 s+ on CPU.
OLLAMA_KEEP_ALIVE=24h
# CPU threads for the model (0 = one per core). If other programs keep cores busy, set this
# below your free core count (e.g. 2-3 on a 6-core CPU): too many threads makes replies crawl.
OLLAMA_NUM_THREAD=0
# Attached documents: characters of their text sent per request (newest first), and the largest
# context window Ollama may grow to for them (more uses more memory; 0 = Ollama's default).
DOCUMENT_MAX_CHARS=40000
OLLAMA_MAX_CTX=16384
# Native runs only: where Ollama listens.
# OLLAMA_BASE_URL=http://localhost:11434
# Docker only: use an Ollama installed on the host (e.g. for direct GPU access on Windows/macOS)
# instead of the bundled container.
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434

# Claude: needed only when LLM_PROVIDER=anthropic (or when switching to it in Settings).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low keeps voice replies fast; raise to medium/high for harder questions.
ANTHROPIC_EFFORT=low

# ---- Tasks -----------------------------------------------------------------
# Every task (email, event, document, workflow) is drafted for your review and runs only
# when you press Approve.
# Email: without SMTP, an approved email opens filled in and ready to send in
# gmail (Gmail on the web) | outlook (Outlook.com) | mail_app (the computer's default mail program).
EMAIL_COMPOSE=gmail
# Save approved emails straight into your Gmail Drafts (recommended): your Gmail address and a
# Gmail app password (Google Account > Security > 2-Step Verification > App passwords;
# https://myaccount.google.com/apppasswords). The email waits in Drafts until you press Send.
# Other providers: also set IMAP_HOST (and IMAP_DRAFTS_FOLDER if Drafts isn't found).
IMAP_USERNAME=
IMAP_PASSWORD=
# Or send directly over SMTP (then EMAIL_COMPOSE is not used):
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address; defaults to SMTP_USERNAME.
SMTP_FROM=
# Workflows the assistant may run, as JSON {"name": "webhook URL"} (n8n, Zapier, Home Assistant...).
# Approved runs POST {"workflow", "input", "action_id"} to the URL. Only these URLs are ever called.
# WORKFLOWS={"backup-photos": "http://host.docker.internal:5678/webhook/backup"}

# ---- Phone notifications ---------------------------------------------------
# A reminder on your phone when an email or other task is waiting for your review.
# It only reminds: approving still happens in the app, so nothing is sent from the phone.
# SMS: your number in international format, plus a Twilio account (twilio.com; a free trial
# can text your own verified number). TWILIO_FROM is your Twilio number or a Messaging Service SID (MG...).
NOTIFY_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Free alternative: push notifications through the ntfy app (ntfy.sh). Pick a long, hard-to-guess
# topic name and subscribe to it in the app: anyone who knows the topic can read the messages.
NTFY_TOPIC=
# Remind once more if a task is still waiting after this many minutes (0 = off).
NOTIFY_REMIND_MINUTES=30
# Link added to notifications: the address phones open, e.g. https://192.168.1.10:8443
# (scripts/lan.ps1 sets it).
APP_URL=

# ---- Speech ----------------------------------------------------------------
# faster-whisper model: tiny.en, base.en, small.en, medium.en, or multilingual tiny/base/small/medium/large-v3
STT_MODEL=base.en
# Language code (en, vi, de, ...) or empty for auto-detect (use a multilingual STT_MODEL).
STT_LANGUAGE=en
# piper (local neural voice) | browser (Web Speech API in the browser) | none
TTS_ENGINE=piper
# Any voice from https://huggingface.co/rhasspy/piper-voices, e.g. en_GB-alan-medium, vi_VN-vais1000-medium
PIPER_VOICE=en_US-lessac-medium
# Trailing silence (ms) that ends your turn in hands-free mode.
VAD_SILENCE_MS=800

# ---- Wake word ---------------------------------------------------------------
WAKEWORD_DEFAULT=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# Port for the web UI (Docker)
APP_PORT=8080

# ---- Phones, tablets and other computers -----------------------------------
# scripts/lan.ps1 (Windows) or scripts/lan.sh fills these in for your network.
# They open https://<this computer's LAN IP>:8443 and enter the passcode once per device.
# Without a passcode (at least 6 characters) other devices are turned away.
APP_PASSCODE=
# This computer's LAN IP address (or name.local), comma-separated, for the HTTPS certificate.
TLS_HOSTS=
APP_HTTPS_PORT=8443
# 0.0.0.0 = reachable from your network; 127.0.0.1 = this computer only.
REMOTE_BIND=0.0.0.0
